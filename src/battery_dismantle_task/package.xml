<?xml version="1.0"?>
<package format="3">
  <name>battery_dismantle_task</name>
  <version>0.1.0</version>
  <description>LLM-controlled battery disassembly task using Kinova Gen3 with Robotiq gripper</description>
  <maintainer email="olivia@example.com">Olivia</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- MoveIt and robot -->
  <depend>moveit_fake_controller_manager</depend>
  <depend>kortex_description</depend>

  <!-- Visualisation -->
  <depend>rviz2</depend>

  <!-- Python runtime dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <depend>moveit_py</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
