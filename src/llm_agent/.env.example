# LLM API Configuration
# Copy this file to .env and add your actual API keys

# Which LLM backend the web UI / planner uses: openai | openrouter | ollama
# Defaults to openai if unset (see web_ui.py). Set the matching key below.
LLM_BACKEND=openai

# OpenAI API Key (used when LLM_BACKEND=openai)
OPENAI_API_KEY=your_openai_key_here

# OpenRouter API Key (used when LLM_BACKEND=openrouter; has a free tier)
# Get your key at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Chutes API Token
# CHUTES_API_TOKEN=your_chutes_token_here
